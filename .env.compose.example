# Docker Compose — copy to .env beside docker-compose.yml
POSTGRES_PASSWORD=change-me-strong-password
PUBLIC_DOMAIN=jacms.bluraymaldives.site
APP_URL=https://jacms.bluraymaldives.site
HTTP_PORT=8080
DISPLAY_TIME_ZONE=Indian/Maldives
OPENAI_API_KEY=

# Optional Cloudflare tunnel (profile: tunnel) — public hostname → http://web:80 on your edge config
# CLOUDFLARE_TUNNEL_TOKEN=

# First admin after stack is up:
# docker compose run --rm -e JACMS_ADMIN_NAME=Admin -e JACMS_ADMIN_EMAIL=you@example.com -e JACMS_ADMIN_PASSWORD=secretsecret api npm run create-admin
