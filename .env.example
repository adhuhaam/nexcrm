# Public URL (HTTPS). PUBLIC_DOMAIN is hostname-only; APP_URL wins if set.
PUBLIC_DOMAIN=jacms.bluraymaldives.site
# APP_URL=https://jacms.bluraymaldives.site

DATABASE_URL=postgresql://jacms:CHANGE_ME@127.0.0.1:5432/jacms
# Local dev (peer auth): postgresql:///jacms_dev?host=/var/run/postgresql&user=jacms

# Employee uploads (native install sets this under the server user home).
FILES_DIR=/home/server/JACMS-Files
# FILE_ROOT is an alias for FILES_DIR.

HOST=127.0.0.1
PORT=3000
DISPLAY_TIME_ZONE=Indian/Maldives

# Set to 1 only for local dev without running create-admin (writes .admin-password).
# JACMS_AUTO_SEED_ADMIN=0

OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-4o-mini

# Cloudflare tunnel (optional — install.sh or docker compose profile)
# CLOUDFLARE_TUNNEL_TOKEN=

# Optional authenticated XPAT employer portal (not required for eGov verify sync)
# XPAT_PORTAL_BASE_URL=
# XPAT_PORTAL_CLIENT_ID=
# XPAT_PORTAL_CLIENT_SECRET=
# XPAT_PORTAL_USERNAME=
# XPAT_PORTAL_PASSWORD=
