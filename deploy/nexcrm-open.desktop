[Desktop Entry]
Type=Application
Name=NEXCRM
Comment=Open the NEXCRM office app after login
Exec=/bin/bash -c 'for i in $(seq 1 60); do curl -fsS http://127.0.0.1/health >/dev/null 2>&1 && break; sleep 1; done; xdg-open http://127.0.0.1/'
Icon=web-browser
Terminal=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=3
OnlyShowIn=GNOME;Unity;XFCE;
