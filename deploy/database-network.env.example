# Copy values from deploy/database-network.env after running:
#   sudo ./deploy/install-postgres-network.sh
#
# App on the server should keep using the Unix socket URL in .env.
# Use these TCP URLs from another machine on LAN or Tailscale (psql, GUI, BI tools).

DATABASE_URL_LOCAL=postgresql://nexcrm:PASSWORD@127.0.0.1:5432/nexcrm_dev
DATABASE_URL_LAN=postgresql://nexcrm:PASSWORD@192.168.100.10:5432/nexcrm_dev
DATABASE_URL_TAILSCALE=postgresql://nexcrm:PASSWORD@100.77.125.102:5432/nexcrm_dev
