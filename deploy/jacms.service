[Unit]
Description=JACMS office API and web
Documentation=file:///home/server/dev/jacms/docs/DEPLOY.md
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=server
Group=server
WorkingDirectory=/home/server/dev/jacms
EnvironmentFile=-/home/server/dev/jacms/.env
ExecStart=/usr/bin/node --experimental-strip-types /home/server/dev/jacms/app/server.ts
Restart=on-failure
RestartSec=3
# Bind stays on 127.0.0.1 — nginx / Tailscale Serve publish the app
Environment=HOST=127.0.0.1
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
